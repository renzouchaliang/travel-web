# Build-time, browser-visible AMap JS API key (restrict its allowed domains).
VITE_AMAP_PUBLIC_KEY=
# Public HTTPS URL of the existing AMap security proxy, not a security secret.
# Keep the security code on that proxy; never add it to VITE_* or client source.
VITE_AMAP_SERVICE_HOST=https://travel-web.renzouchaliang.workers.dev/_AMapService
